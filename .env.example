# Firebase Cloud Firestore Configuration (Optional)
# If left unconfigured, the application runs entirely locally.
# To connect Firebase Firestore:
# 1. Download your service account private key JSON from Firebase Console:
#    Project Settings -> Service accounts -> Generate new private key
# 2. Place the JSON file in your project folder (e.g., serviceAccountKey.json).
# 3. Set the path below or set the GOOGLE_APPLICATION_CREDENTIALS environment variable.

FIREBASE_SERVICE_ACCOUNT_KEY="path/to/serviceAccountKey.json"
